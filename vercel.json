{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|@.*|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024
    }
  },
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/warm-db",
      "schedule": "*/15 3-13 * * 1-6"
    }
  ]
}